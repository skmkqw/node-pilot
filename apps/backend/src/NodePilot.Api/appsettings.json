{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "NodePilot": "Debug",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore": "Warning"
        }
    },
    "Monitoring": {
        "Collection": {
            "Enabled": true,
            "IntervalSeconds": 15,
            "CollectCpuUsage": true,
            "CollectRamUsage": true,
            "CollectDiskUsage": true,
            "CollectTemperature": true
        },
        "Retention": {
            "CleanupEnabled": true,
            "MaxMetricAgeHours": 72,
            "CleanupIntervalMinutes": 30,
            "MaxStoredSamples": 250000
        },
        "Alerts": {
            "NotificationsEnabled": false,
            "CpuWarningThresholdPercent": 85,
            "RamWarningThresholdPercent": 90,
            "DiskWarningThresholdPercent": 90,
            "CpuTemperatureWarningCelsius": 80
        }
    },
    "FileManager": {
        "RootPath": "data/files",
        "MaxUploadMegabytes": 4096
    },
    "Auth": {
        "Username": "admin",
        "Password": "",
        "SessionLifetimeHours": 168
    },
    "Cors": {
        "AllowedOrigins": [ "http://localhost:3000" ],
        "AllowPrivateNetworkOrigins": true
    },
    "AllowedHosts": "*"
}