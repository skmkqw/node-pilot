NODE_ENV=production
ASPNETCORE_ENVIRONMENT=Development
NODE_PILOT_DB_CONNECTION_STRING=Data Source=data/nodepilot.db
BACKEND_PORT=5000
WEB_PORT=3000
# Leave empty to reach the backend on port 5000 of whatever host serves the web app
NEXT_PUBLIC_API_URL=
# Host directory shown in the file manager when running with Docker Compose
NODEPILOT_FILES_DIR=./data/files
Auth__Username=admin
Auth__Password=change-me-please
# Optional Pi-hole v6 integration (leave empty to disable)
PiHole__BaseUrl=
PiHole__Password=
