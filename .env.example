# NodePilot runs without any configuration: the administrator account and the
# Pi-hole connection are set up in the app on first start (Settings).
# Everything below is optional.

# Docker Compose: host folder shown in "Files & Media", and the published ports
NODEPILOT_FILES_DIR=./data/files
BACKEND_PORT=5000
WEB_PORT=3000

# Custom database location (default: data/nodepilot.db next to the backend)
# NODE_PILOT_DB_CONNECTION_STRING=Data Source=data/nodepilot.db

# Only if the browser must reach the backend at a different address than <host>:5000
# NEXT_PUBLIC_API_URL=
